<Window x:Class="Task.Parser.XLSX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр и редактирование данных Excel"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Панель действий -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Загрузить файл…" Command="{Binding LoadFileCommand}" Padding="8,3"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid/>
    </DockPanel>
</Window>
