<Window x:Class="Task.Parser.XLSX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр и редактирование данных Excel"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Панель действий -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Загрузить файл…" Command="{Binding LoadFileCommand}" Padding="8,3"/>
                <Separator/>
                <Button Content="Добавить строку" Command="{Binding AddRowCommand}" Padding="8,3"/>
                <Button Content="Удалить строку" Click="OnDeleteClick" Padding="8,3"/>
                <Separator/>
                <Button Content="Сохранить отчёт (CSV)…" Command="{Binding SaveReportCommand}" Padding="8,3"/>
                <Button Content="Сбросить фильтры" Command="{Binding ClearFiltersCommand}" Padding="8,3"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Фильтрация строк по столбцам: для каждого столбца оператор и значение -->
            <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                    Padding="6,6,6,2">
                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="110"
                                           TextTrimming="CharacterEllipsis"/>
                                <ComboBox ItemsSource="{Binding Operators}"
                                          SelectedItem="{Binding SelectedOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="92" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                         Width="130" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Область предпросмотра с прокруткой; строки изменяются прямо в таблице -->
            <DataGrid x:Name="Grid" Grid.Row="1"
                      ItemsSource="{Binding View}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
